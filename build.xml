<?xml version="1.0" encoding="UTF-8"?>
<project default="xar" name="existdb-dashboard">
    <xmlproperty file="expath-pkg.xml"/>
    <property name="project.version" value="${package(version)}"/>
    <property name="project.app" value="${package(abbrev)}"/>
    <property name="build.dir" value="build"/>

    <!--
    Creates a development XAR package.
    Requires: npm run build (to generate dist/ bundles)
    -->
    <target name="xar">
        <mkdir dir="${build.dir}"/>
        <zip destfile="${build.dir}/${project.app}-${project.version}.xar">
            <fileset dir="${basedir}">
                <!-- Entry points -->
                <include name="index.html"/>
                <include name="login.html"/>
                <include name="guest.html"/>

                <!-- XQuery modules -->
                <include name="*.xql"/>
                <include name="modules/**"/>

                <!-- Vite-built JS bundles -->
                <include name="dist/**"/>

                <!-- Static resources -->
                <include name="resources/**"/>

                <!-- eXist-db package descriptors -->
                <include name="*.xml"/>
                <include name="icon.svg"/>

                <!-- Exclude build artifacts and dev files -->
                <exclude name="build.xml"/>
            </fileset>
        </zip>
    </target>

    <!--
    Creates a production XAR.
    Runs npm build first, then packages.
    -->
    <target name="production-xar">
        <exec executable="npm" failonerror="true">
            <arg value="run"/>
            <arg value="build"/>
        </exec>
        <antcall target="xar"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="dist"/>
    </target>
</project>
